# programs.json を読むリポジトリと、その Contents を読めるだけのトークン（Fine-grained token, Contents: Read-only）
GITHUB_REPO=yxmxgxn/hp-watch
GITHUB_TOKEN=

# 通知先（Discord の Webhook URL）
DISCORD_WEBHOOK=

# healthchecks.io の Ping URL。NAS が止まったらそちらが知らせる。空なら使わない
HEALTHCHECK_URL=

# rclone.conf の中のリモート名 + ":"。BOX に送らないなら空に
BOX_REMOTE=box:

# radiko プレミアムに入ったら書く。空なら住んでいる地域（NAS の回線の地域）の局だけ
RADIKO_MAIL=
RADIKO_PASS=

INTERVAL_HOURS=6
